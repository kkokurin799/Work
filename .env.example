DATABASE_URL=postgres://work:work@localhost:5432/work
SESSION_SECRET=replace-with-a-long-random-string
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me
APP_BASE_URL=http://localhost:3000
TZ=Europe/Moscow

# Срез Telegram. Пока переменные пустые, бот не принимается и алерты не уходят.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_USER_ID=

# Срез почты. Пока переменные пустые, ящик не опрашивается.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_ALLOWED_FROM=
